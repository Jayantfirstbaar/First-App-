{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "isPro": { "type": "boolean" },
        "aiUsageThisMonth": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Customer lead information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "stage": { "type": "string" }
      },
      "required": ["id", "userId", "customerName", "stage"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/leads/{leadId}": {
      "schema": "Lead",
      "description": "User specific leads"
    }
  }
}
